{
  "$schema": "./enterprise-config.schema.json",
  "version": "1.0.0",
  "projectName": "Aux petits Oignons",
  "description": "Configuration entreprise pour déploiements Azure de bots Copilot Studio",

  "azure": {
    "namingConventions": {
      "prefix": "aux",
      "separator": "-",
      "resourceGroupFormat": "{prefix}{separator}{environment}{separator}{project}"
    },
    "mandatoryTags": {
      "environment": "prod|dev|test",
      "project": "copilot-studio",
      "owner": "consulting-team"
    },
    "defaultRegion": "francecentral"
  },

  "aiModels": [
    {
      "id": "claude-sonnet",
      "name": "Claude Sonnet",
      "provider": "anthropic",
      "default": true,
      "enabled": true,
      "azureEndpoint": "${ANTHROPIC_BASE_URL}",
      "azureDeployment": "claude-sonnet-4-5"
    },
    {
      "id": "gpt-4.1-mini",
      "name": "GPT-4.1 Mini",
      "provider": "azure",
      "default": false,
      "enabled": true,
      "azureEndpoint": "${AZURE_OPENAI_ENDPOINT}",
      "azureDeployment": "gpt-4-1-mini"
    },
    {
      "id": "gpt-5-mini",
      "name": "GPT-5 Mini",
      "provider": "azure",
      "default": false,
      "enabled": true,
      "azureEndpoint": "${AZURE_OPENAI_ENDPOINT}",
      "azureDeployment": "gpt-5-mini"
    },
    {
      "id": "model-routeur",
      "name": "Model Routeur",
      "provider": "azure",
      "default": false,
      "enabled": true,
      "azureEndpoint": "${AZURE_AI_FOUNDRY_ENDPOINT}",
      "azureDeployment": "model-router"
    }
  ],

  "deployment": {
    "templates": {
      "bicep": "templates/azure/",
      "functions": "templates/functions/"
    },
    "defaultEnvironment": "dev"
  },

  "ui": {
    "branding": {
      "appName": "Aux petits Oignons",
      "tagline": "Déploiements Azure simplifiés pour Copilot Studio"
    },
    "features": {
      "welcomePage": true,
      "modelSelection": true,
      "azureTemplates": true,
      "guidedDeployment": true
    }
  },

  "locked": false,
  "_comment": "Configuration sera verrouillée dans STORY-004 pour empêcher modifications utilisateur"
}
