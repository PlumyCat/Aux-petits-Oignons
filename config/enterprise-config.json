{
  "$schema": "./enterprise-config.schema.json",
  "version": "1.0.0",
  "projectName": "Aux petits Oignons",
  "description": "Configuration entreprise pour déploiements Azure de bots Copilot Studio",

  "locked": true,
  "enforceProviders": true,

  "azure": {
    "namingConventions": {
      "prefix": "aux",
      "separator": "-",
      "resourceGroupFormat": "{prefix}{separator}{environment}{separator}{project}"
    },
    "mandatoryTags": {
      "environment": "prod|dev|test",
      "project": "copilot-studio",
      "owner": "consulting-team"
    },
    "defaultRegion": "francecentral"
  },

  "aiModels": [
    {
      "id": "gpt-5.3-codex",
      "name": "GPT-5.3 Codex",
      "provider": "azure",
      "default": true,
      "enabled": true,
      "azureEndpoint": "${AZURE_OPENAI_ENDPOINT}",
      "azureDeployment": "gpt-5.3-codex"
    }
  ],

  "deployment": {
    "templates": {
      "bicep": "templates/azure/",
      "functions": "templates/functions/"
    },
    "defaultEnvironment": "dev"
  },

  "ui": {
    "branding": {
      "appName": "Aux petits Oignons",
      "tagline": "Déploiements Azure simplifiés pour Copilot Studio"
    },
    "features": {
      "welcomePage": true,
      "modelSelection": true,
      "azureTemplates": true,
      "guidedDeployment": true
    }
  },

  "_comment": "Configuration verrouillée - Ne peut être modifiée que par l'équipe technique. Les consultants ne peuvent pas modifier ce fichier."
}
